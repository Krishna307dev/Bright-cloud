# USBCloudBackup — Backblaze B2 Authorizer Environment Variables Example
#
# DO NOT COMMIT `.env` OR ANY REAL SECRETS TO SOURCE CONTROL.

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# Backblaze B2 S3 Configuration
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_BUCKET=BrightCloud
B2_REGION=eu-central-003

# Backblaze B2 Secrets (Server-Side Only)
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key

# Service Settings
ENVIRONMENT=production
