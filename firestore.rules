rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isGoogleUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function getVaultSettings(vaultId) {
      return get(/databases/$(database)/documents/vaults/$(vaultId)/settings/config).data;
    }

    function hasVaultSettings(vaultId) {
      return exists(/databases/$(database)/documents/vaults/$(vaultId)/settings/config);
    }

    function isAdmin(vaultId) {
      return isGoogleUser() && hasVaultSettings(vaultId) &&
        'adminUids' in getVaultSettings(vaultId) &&
        request.auth.uid in getVaultSettings(vaultId).adminUids;
    }

    function isValidApprovalPayload(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['uid', 'email', 'name', 'reason', 'referredBy', 'status', 'createdAt', 'updatedAt']) &&
        data.uid == userId &&
        data.status == 'pending' &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.reason is string && data.reason.size() > 0 && data.reason.size() <= 1000 &&
        data.referredBy is string && data.referredBy.size() > 0 && data.referredBy.size() <= 100 &&
        (!('email' in data) || ('email' in request.auth.token && data.email == request.auth.token.email));
    }

    function isAuthorizedFriend(vaultId) {
      return isGoogleUser() && hasVaultSettings(vaultId) &&
        'authorizedFriends' in getVaultSettings(vaultId) &&
        request.auth.uid in getVaultSettings(vaultId).authorizedFriends;
    }

    function isJobTerminal(vaultId, jobId) {
      return !exists(/databases/$(database)/documents/vaults/$(vaultId)/backupJobs/$(jobId)) ||
        get(/databases/$(database)/documents/vaults/$(vaultId)/backupJobs/$(jobId)).data.state in ['COMPLETED', 'FAILED', 'CANCELLED'];
    }

    // --- Shared Vault Namespace: vaults/{vaultId} ---
    match /vaults/{vaultId} {

      // 1. Settings: Google Admins ONLY; Daemons & Friends: DENIED
      match /settings/{docId} {
        allow read, write: if isAdmin(vaultId);
      }

      // 2. USB Sources:
      // - Read: Admin & Authorized Friends
      // - Write: Admin full; Anonymous daemon create/update its own source
      // - Immutable fields: sourceId, volumeUuid, firstSeen
      // - Delete: Admin only
      match /sources/{sourceId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId);
        allow create: if isAdmin(vaultId) || (
          isAnonymous() &&
          request.resource.data.sourceId == sourceId &&
          request.resource.data.keys().hasOnly([
            'sourceId', 'usbVendorId', 'usbProductId', 'serialNumber',
            'volumeUuid', 'displayName', 'firstSeen', 'lastSeen', 'totalFilesBackedUp'
          ])
        );
        allow update: if isAdmin(vaultId) || (
          isAnonymous() &&
          request.resource.data.sourceId == resource.data.sourceId &&
          (resource.data.volumeUuid == null || request.resource.data.volumeUuid == resource.data.volumeUuid) &&
          (resource.data.firstSeen == null || request.resource.data.firstSeen == resource.data.firstSeen) &&
          request.resource.data.keys().hasOnly([
            'sourceId', 'usbVendorId', 'usbProductId', 'serialNumber',
            'volumeUuid', 'displayName', 'firstSeen', 'lastSeen', 'totalFilesBackedUp'
          ])
        );
        allow delete: if isAdmin(vaultId);
      }

      // 3. Files:
      // - Read: Admin & Authorized Friends; Anonymous DAEMON: DENIED (false)
      // - Create: Admin (web uploads); Anonymous daemon (backup ingest)
      // - Update: Admin only; Anonymous & Friends: DENIED (false)
      // - Delete: Admin only; Anonymous & Friends: DENIED (false)
      match /files/{fileId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId);
        allow create: if isAdmin(vaultId) || isAnonymous();
        allow update: if isAdmin(vaultId);
        allow delete: if isAdmin(vaultId);
      }

      // 4. Content Hash Index:
      // - Read: Admin, Friends, Anonymous Daemon (for deduplication lookup)
      // - Create: Admin, Anonymous Daemon (hash registration)
      // - Update: NEVER (false)
      // - Delete: Admin only (for storage reset)
      match /contentHashes/{hashId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId) || isAnonymous();
        allow create: if (isAdmin(vaultId) || isAnonymous()) &&
                         request.resource.data.sha256 == hashId &&
                         hashId.size() == 64;
        allow update: if false;
        allow delete: if isAdmin(vaultId);
      }

      // 5. Backup Jobs:
      // - Read: Admin & Friends
      // - Write: Admin & Anonymous Daemon
      // - Immutable fields: jobId, sourceId, startedAt
      // - Terminal state protection: Cannot rewrite completed/failed jobs
      // - Delete: Admin only
      match /backupJobs/{jobId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId);
        allow create: if isAdmin(vaultId) || (
          isAnonymous() &&
          request.resource.data.jobId == jobId &&
          request.resource.data.keys().hasOnly([
            'jobId', 'sourceId', 'state', 'startedAt', 'completedAt',
            'totalFiles', 'skippedFiles', 'uploadedFiles', 'errorFiles'
          ])
        );
        allow update: if isAdmin(vaultId) || (
          isAnonymous() &&
          request.resource.data.jobId == resource.data.jobId &&
          request.resource.data.sourceId == resource.data.sourceId &&
          request.resource.data.startedAt == resource.data.startedAt &&
          !(resource.data.state in ['COMPLETED', 'FAILED', 'CANCELLED']) &&
          request.resource.data.keys().hasOnly([
            'jobId', 'sourceId', 'state', 'startedAt', 'completedAt',
            'totalFiles', 'skippedFiles', 'uploadedFiles', 'errorFiles'
          ])
        );
        allow delete: if isAdmin(vaultId);
      }

      // 6. Name Reservations: Atomic Lock Mechanism
      // - Read/Write: Admin & Anonymous Daemon
      // - Friends: DENIED (false)
      // - Protection: COMMITTED reservations cannot be overwritten
      match /nameReservations/{resId} {
        allow read: if isAdmin(vaultId) || isAnonymous();
        allow create: if isAdmin(vaultId) || (
          isAnonymous() &&
          request.resource.data.reservationId == resId &&
          request.resource.data.status == 'PENDING'
        );
        allow update: if isAdmin(vaultId) || (
          isAnonymous() &&
          resource.data.status != 'COMMITTED' &&
          request.resource.data.reservationId == resource.data.reservationId &&
          request.resource.data.b2ObjectKey == resource.data.b2ObjectKey &&
          (
            (request.resource.data.status == 'COMMITTED' && request.resource.data.jobId == resource.data.jobId) ||
            (request.resource.data.jobId == resource.data.jobId) ||
            (request.time > resource.data.expiresAt) ||
            (
              resource.data.status == 'PENDING' &&
              request.resource.data.status == 'PENDING' &&
              request.resource.data.sha256 == resource.data.sha256 &&
              request.resource.data.sourceId == resource.data.sourceId &&
              request.resource.data.relativePath == resource.data.relativePath &&
              request.resource.data.originalName == resource.data.originalName &&
              request.resource.data.storedName == resource.data.storedName &&
              request.resource.data.storageBackend == resource.data.storageBackend &&
              request.resource.data.vaultId == resource.data.vaultId &&
              (!('version' in resource.data) || request.resource.data.version == resource.data.version) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobId', 'ownerTaskId', 'createdAt', 'expiresAt']) &&
              isJobTerminal(vaultId, resource.data.jobId)
            )
          )
        );
        allow delete: if isAdmin(vaultId);
      }

      // 7. Folder Access Rules:
      // - Read: Admin & Friends
      // - Write: Admin only
      // - Anonymous Daemon: DENIED (false)
      match /folderRules/{ruleId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId);
        allow write: if isAdmin(vaultId);
      }

      // 8. User Profiles:
      // - Authenticated Google users can read their own profile; Admin can read all
      // - Authenticated Google users can create their own profile with role 'pending' (or omitted)
      // - Authenticated Google users can update their profile fields without changing their role
      // - Admin can manage all user profiles and roles
      match /users/{userId} {
        allow read: if isAdmin(vaultId) || (isGoogleUser() && request.auth.uid == userId);
        allow create: if isAdmin(vaultId) || (
          isGoogleUser() && request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          request.resource.data.role == 'pending'
        );
        allow update: if isAdmin(vaultId) || (
          isGoogleUser() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role
        );
        allow delete: if isAdmin(vaultId);
      }

    }

    // Approval Requests (top-level collection: approvalRequests/{userId})
    match /approvalRequests/{userId} {
      allow read: if isAdmin('default') || (isGoogleUser() && request.auth.uid == userId);
      allow create: if isGoogleUser() && request.auth.uid == userId && isValidApprovalPayload(userId);
      allow update: if (
        isGoogleUser() && request.auth.uid == userId &&
        resource.data.status == 'pending' &&
        request.resource.data.createdAt == resource.data.createdAt &&
        isValidApprovalPayload(userId)
      ) || (
        isAdmin('default') &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      );
      allow delete: if isAdmin('default');
    }

    // Catch-all: Deny all unauthenticated or unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
