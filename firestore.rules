rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isGoogleUser() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function getVaultSettings(vaultId) {
      return get(/databases/$(database)/documents/vaults/$(vaultId)/settings/config).data;
    }

    function hasVaultSettings(vaultId) {
      return exists(/databases/$(database)/documents/vaults/$(vaultId)/settings/config);
    }

    function isAdmin(vaultId) {
      return isGoogleUser() && hasVaultSettings(vaultId) &&
      'adminUids' in getVaultSettings(vaultId) &&
      request.auth.uid in getVaultSettings(vaultId).adminUids;
    }

    function isAuthorizedFriend(vaultId) {
      return isGoogleUser() && hasVaultSettings(vaultId) &&
      'authorizedFriends' in getVaultSettings(vaultId) &&
      request.auth.uid in getVaultSettings(vaultId).authorizedFriends;
    }

    // --- Shared Vault Namespace: vaults/{vaultId} ---
    match /vaults/{vaultId} {

      // 1. Settings: Google Admins ONLY; Daemons & Friends: DENIED
      match /settings/{docId} {
        allow read, write: if isAdmin(vaultId);
      }

      // 2. USB Sources:
      // - Read: Admin & Authorized Friends & Anonymous Daemon
      // - Write: Admin & Anonymous Daemon
      // - Delete: Admin only
      match /sources/{sourceId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId) || isAnonymous();
        allow write: if isAdmin(vaultId) || isAnonymous();
        allow delete: if isAdmin(vaultId);
      }

      // 3. Files:
      // - Read: Admin & Authorized Friends; Anonymous DAEMON: DENIED (false)
      // - Create: Admin (web uploads); Anonymous daemon (backup ingest)
      // - Update: Admin only; Anonymous & Friends: DENIED (false)
      // - Delete: Admin only; Anonymous & Friends: DENIED (false)
      match /files/{fileId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId);
        allow create: if isAdmin(vaultId) || isAnonymous();
        allow update: if isAdmin(vaultId);
        allow delete: if isAdmin(vaultId);
      }

      // 4. Content Hash Index:
      // - Read: Admin, Friends, Anonymous Daemon (for deduplication lookup)
      // - Create: Admin, Anonymous Daemon (hash registration)
      // - Update, Delete: Admin only
      match /contentHashes/{hashId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId) || isAnonymous();
        allow create: if isAdmin(vaultId) || isAnonymous();
        allow update, delete: if isAdmin(vaultId);
      }

      // 5. Backup Jobs:
      // - Read: Admin, Friends & Anonymous Daemon
      // - Write: Admin & Anonymous Daemon
      // - Delete: Admin only
      match /backupJobs/{jobId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId) || isAnonymous();
        allow write: if isAdmin(vaultId) || isAnonymous();
        allow delete: if isAdmin(vaultId);
      }

      // 6. Name Reservations: Atomic Lock Mechanism
      // - Read/Write: Admin & Anonymous Daemon
      // - Delete: Admin only
      match /nameReservations/{resId} {
        allow read, write: if isAdmin(vaultId) || isAnonymous();
        allow delete: if isAdmin(vaultId);
      }

      // 7. Folder Access Rules:
      // - Read: Admin & Friends
      // - Write: Admin only
      // - Anonymous Daemon: DENIED (false)
      match /folderRules/{ruleId} {
        allow read: if isAdmin(vaultId) || isAuthorizedFriend(vaultId);
        allow write: if isAdmin(vaultId);
      }

      // 8. User Profiles:
      match /users/{userId} {
        allow read: if isAdmin(vaultId) || (isGoogleUser() && request.auth.uid == userId);
        allow create, update: if isAdmin(vaultId) || (isGoogleUser() && request.auth.uid == userId);
        allow delete: if isAdmin(vaultId);
      }

    }

    // Approval Requests (top-level collection: approvalRequests/{userId})
    match /approvalRequests/{userId} {
      allow read: if isAdmin('default') || (isGoogleUser() && request.auth.uid == userId);
      allow create, update, delete: if (isGoogleUser() && request.auth.uid == userId) || isAdmin('default');
    }

    // Catch-all: Deny all unauthenticated or unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
