### Component 4: Storage & Lifecycle Layer (`app/src/main/java/.../storage/` & `.../worker/`)

#### [MODIFY] `app/src/main/java/com/usbcloudbackup/worker/BackupWorker.kt`
- **Fix BUG-05**: Register a dynamic `BroadcastReceiver` for `ACTION_USB_DEVICE_DETACHED` strictly during the `doWork()` lifecycle using `try/finally` unregistration and `ContextCompat.RECEIVER_EXPORTED`:
```kotlin
val workerJob = currentCoroutineContext().job
val detachReceiver = object : BroadcastReceiver() {
    override fun onReceive(context: Context, intent: Intent) {
        if (intent.action == UsbManager.ACTION_USB_DEVICE_DETACHED) {
            val device = getUsbDeviceFromIntent(intent)
            val detachedId = device?.let {
                SourceIdResolver.resolveCanonicalSourceId(context, it) ?: SourceIdResolver.computeSourceId(null, it)
            }
            if (detachedId == null || detachedId == sourceId || !storageSource.isAvailable()) {
                Log.w(TAG, "Active USB detached for sourceId=$sourceId. Preempting backup work.")
                workerJob.cancel(CancellationException("USB device detached: $sourceId"))
                BackupWorkManager.cancelBackup(context, sourceId)
            }
        }
    }
}
val filter = IntentFilter(UsbManager.ACTION_USB_DEVICE_DETACHED)
// ContextCompat.RECEIVER_EXPORTED guarantees delivery of system-server broadcasts on Android 14+ (API 34+)
// and safely delegates on API 24-32. ACTION_USB_DEVICE_DETACHED is a protected system broadcast.
ContextCompat.registerReceiver(applicationContext, detachReceiver, filter, ContextCompat.RECEIVER_EXPORTED)
try {
    // Run backup pipeline...
} finally {
    try {
        applicationContext.unregisterReceiver(detachReceiver)
    } catch (e: Exception) {
        Log.w(TAG, "Error unregistering detach receiver", e)
    }
}
```

